# Normalise line endings so the repo is identical on Windows, macOS and Linux.
* text=auto eol=lf

# Windows-only scripts must keep CRLF or cmd.exe misreads them.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: never touch.
*.png binary
*.jpg binary
*.webp binary
*.ico binary
*.jar binary
*.joblib binary
*.zip binary
