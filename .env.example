# ---------------------------------------------------------------------------
# Denmark Road Assistant - every setting the backend reads.
#
# Copy to .env and change what you need. EVERY value here has a working default
# except APP_JWT_SECRET, so you can also just delete this file and run the app.
#
# The previous version of this file listed only four variables and omitted all
# five database ones - which were exactly the settings you needed in order to
# get the database the README told you was the default.
# ---------------------------------------------------------------------------

# --- Ports and addresses ---------------------------------------------------
SERVER_PORT=8080
ML_SERVICE_BASE_URL=http://localhost:8000
FRONTEND_ORIGINS=http://localhost:4200,http://localhost,capacitor://localhost,https://localhost

# --- Login tokens ----------------------------------------------------------
# LEAVE THIS UNSET FOR LOCAL DEVELOPMENT. The app generates a random key each
# start and warns you. Set it only if you want logins to survive a restart, and
# then it must be at least 32 characters:  openssl rand -base64 48
#
# The app REFUSES TO START without it under a prod/production/staging profile,
# and rejects the old demo secret that used to be committed to this repository.
# APP_JWT_SECRET=
APP_JWT_EXPIRATION_MS=86400000

# --- Database --------------------------------------------------------------
# Default: a file-based H2 database created automatically at backend/data/.
# Nothing needs to be installed and no password is needed.
SPRING_DATASOURCE_URL=jdbc:h2:file:./data/road-assistant;AUTO_SERVER=TRUE;DB_CLOSE_DELAY=-1
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# For MySQL, prefer the profile instead of editing these:
#     ./mvnw spring-boot:run -Dspring-boot.run.profiles=mysql
# and supply only the credentials here:
# SPRING_DATASOURCE_USERNAME=road_assistant
# SPRING_DATASOURCE_PASSWORD=your-password
#
# Note there is deliberately no SPRING_DATASOURCE_DRIVER_CLASS_NAME. Spring works
# the driver out from the URL. Pinning it separately used to mean that pointing
# the URL at H2 still loaded the MySQL driver, and startup failed.

# --- Weather ---------------------------------------------------------------
# Open-Meteo needs no API key.
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SECONDS=8
