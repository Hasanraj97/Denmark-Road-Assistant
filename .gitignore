# ---------------------------------------------------------------------------
# Denmark Road Assistant — root ignore file
#
# NOTE: this file used to be called ".gitignore.txt", which Git never reads,
# so build junk and an 82 MB model file were being committed. Keep the name
# exactly ".gitignore" (no extension) or the problem comes straight back.
# ---------------------------------------------------------------------------

# --- Node / Angular --------------------------------------------------------
node_modules/
dist/
.angular/
*.tsbuildinfo

# --- Java / Maven ----------------------------------------------------------
target/
*.log
.mvn/wrapper/maven-wrapper.jar

# --- Python / ML service ---------------------------------------------------
__pycache__/
*.py[cod]
*.pyc.*
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Trained model artefacts are large (~80 MB) and are regenerated on first
# start of the ML service. They must never be committed.
*.joblib
ml-service/models/*.joblib
!ml-service/models/.gitkeep
!ml-service/data/.gitkeep

# --- Local databases (H2 file store) ---------------------------------------
*.mv.db
*.trace.db
backend/data/

# --- Secrets ---------------------------------------------------------------
.env
.env.local
*.env
!.env.example

# --- Archives (a stale backend.zip used to be committed here) --------------
*.zip

# --- Capacitor / Android ---------------------------------------------------
# capacitor-cordova-android-plugins is GENERATED by `npx cap sync android`.
# It is not committed, which is why a fresh clone cannot open the Android
# project until that command has been run once. See README, Android section.
frontend/android/capacitor-cordova-android-plugins/
frontend/android/.gradle/
frontend/android/app/build/
frontend/android/build/
frontend/android/local.properties
frontend/android/app/src/main/assets/public/
frontend/android/app/src/main/assets/capacitor.config.json
frontend/android/app/src/main/assets/capacitor.plugins.json

# --- IDE -------------------------------------------------------------------
.idea/
*.iws
*.iml
*.ipr
.vscode/*
!.vscode/extensions.json
.settings/
.classpath
.project

# --- OS --------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.audit/

# --- Runtime logs from start-all.sh / start-all.ps1 ------------------------
logs/

# --- Local-only files from the thesis review update ------------------------
# Backups made when the review fixes were applied, the update package itself,
# and older or repeat evidence runs. Only output-review (run 4, the evidence
# the thesis quotes) is committed.
*.before-review
*.before-fix
thesis-evidence/review-update/
thesis-evidence/output/
thesis-evidence/output-final-check/
Claude outputs/
